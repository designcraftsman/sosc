	"item": [
		{
			"name": "Contact Form",
			"item": [
				{
					"name": "Submit Contact Form",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 or 201\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"subject\": \"Demande de renseignements\",\n  \"message\": \"Je souhaite en savoir plus sur vos services de crédit.\",\n  \"suspicious\": false\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/submit-form",
							"host": ["{{baseUrl}}"],
							"path": ["api", "submit-form"]
						},
						"description": "Public endpoint - Submit contact form from frontend"
					},
					"response": []
				},
				{
					"name": "Submit Contact Form (XSS Attack Test)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Attacker\",\n  \"email\": \"attacker@evil.com\",\n  \"subject\": \"Test\",\n  \"message\": \"Normal message\",\n  \"suspicious\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/submit-form",
							"host": ["{{baseUrl}}"],
							"path": ["api", "submit-form"]
						},
						"description": "Test XSS detection with suspicious flag set to true"
					},
					"response": []
				}
			]
		},
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"token\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"your_password\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						},
						"description": "Admin login - Returns JWT token"
